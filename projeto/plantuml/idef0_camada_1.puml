@startuml idef0_camada_1

skinparam monochrome true
skinparam shadowing false
skinparam rectangle {
    BackgroundColor WHITE
    BorderColor BLACK
    FontColor BLACK
    FontSize 10
    BorderThickness 2
}

skinparam arrow {
    Color BLACK
    FontColor BLACK
    FontSize 9
    Thickness 1
}

skinparam linetype ortho
top to bottom direction

' Layout em grid seguindo a imagem original

' Linha superior - Controle
rectangle "PPC ES" as ppc {
}

' Linha das entradas e processos
rectangle "Alunos" as alunos
rectangle "I - Matrículas e\nFormação de\nGrupos\n\nA1" as a1
rectangle "Turma\nGrupos" as saida1

rectangle "Empresa Parceira Inteli" as empresa
rectangle "II - Configuração\ndo Meta Projeto\n(TAPI)\n\nA2" as a2
rectangle "Meta Projeto Configurado TAPI" as saida2

rectangle "Autoestudos\nAtividades Projetos" as atividades
rectangle "III - Aplicação do\nMódulo\n\nA3" as a3
rectangle "Instruções Realizadas\nProva\nSprint Planning\nArtefatos\nSprint Review\nPitches" as saida3

' Mecanismos inferiores
rectangle "Professor Orientador" as prof_orientador
rectangle "Professores\nComputação\nMatemática e Física\nLiderança\nNegócios" as professores

' Posicionamento vertical
ppc -[hidden]down- alunos
alunos -[hidden]down- empresa
empresa -[hidden]down- atividades

a1 -[hidden]down- a2
a2 -[hidden]down- a3

saida1 -[hidden]down- saida2
saida2 -[hidden]down- saida3

' Posicionamento horizontal
alunos -[hidden]right- a1
a1 -[hidden]right- saida1

empresa -[hidden]right- a2
a2 -[hidden]right- saida2

atividades -[hidden]right- a3
a3 -[hidden]right- saida3

' Relacionamentos de controle (PPC para todos)
ppc -down-> a1
ppc -down-> a2
ppc -down-> a3

' Relacionamentos entrada -> processo -> saída
alunos -right-> a1
a1 -right-> saida1

empresa -right-> a2
a2 -right-> saida2

atividades -right-> a3
a3 -right-> saida3

' Relacionamentos sequenciais entre processos
a1 -down-> a2
a2 -down-> a3

' Relacionamentos de mecanismo
prof_orientador -up-> a1
professores -up-> a3

@enduml