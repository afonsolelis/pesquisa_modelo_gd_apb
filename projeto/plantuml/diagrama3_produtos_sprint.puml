@startuml diagrama3_produtos_sprint
!define PRIMARY_COLOR #2E86AB
!define SECONDARY_COLOR #A23B72
!define ACCENT_COLOR #F18F01
!define SUCCESS_COLOR #C73E1D

skinparam class {
    BackgroundColor WHITE
    BorderColor PRIMARY_COLOR
    HeaderBackgroundColor PRIMARY_COLOR
    HeaderFontColor WHITE
    AttributeFontColor BLACK
    FontSize 10
}

skinparam arrow {
    Color PRIMARY_COLOR
    FontColor PRIMARY_COLOR
    FontSize 9
}

package "Produtos e Atividades da Sprint" {

    class Sprint <<Ciclo-Central>> {
        + sprint_id : String
        + numero : Integer [1..5]
        + data_inicio : Date
        + data_fim : Date
        + metas_definidas : List<String>
        + criterios_pronto : List<String>
        --
        + executaCiclo() : void
        + validaEntregas() : Boolean
        + consolidaResultados() : void
    }

    class Artefato <<Produto-Tangivel>> {
        + artefato_id : String
        + nome : String
        + tipo : String [Código|Documento|Protótipo|Relatório]
        + versao : String
        + autor_principal : String
        + data_entrega : Date
        + tamanho_arquivo : Long
        + url_repositorio : String
        --
        + validaQualidade() : Boolean
        + rastreiaVersoes() : List<Versao>
        + vinculaRequisitos() : List<String>
    }

    class Pitch <<Apresentacao-Obrigatoria>> {
        + pitch_id : String
        + data_apresentacao : Date
        + duracao_minutos : Integer [15..30]
        + participantes : List<String>
        + avaliadores : List<String>
        + nota_apresentacao : Float
        + feedback_qualitativo : Text
        --
        + preparaApresentacao() : void
        + demonstraSolucao() : void
        + recebeAvaliacao() : Float
        + registraFeedback() : void
    }

    class AutoEstudo <<Atividade-Preparatoria>> {
        + autoestudo_id : String
        + titulo : String
        + eixo_conhecimento : String
        + conteudo_referencia : String
        + prazo_conclusao : Date
        + tempo_estimado_horas : Integer
        + ponderado : Boolean
        + peso_avaliativo : Float
        --
        + defineConteudo() : void
        + acompanhaProgresso() : void
        + avaliaConclusao() : Float
    }

    class AtividadePonderada <<Avaliacao-Formal>> {
        + ap_id : String
        + titulo : String
        + eixo_avaliado : String
        + tipo : String [Individual|Grupo|Mista]
        + peso_nota : Float
        + criterios_rubrica : List<String>
        + nota_obtida : Float
        + data_aplicacao : Date
        --
        + aplicaInstrumento() : void
        + corrigeSubmissoes() : void
        + atribuiNotas() : Map<String, Float>
        + geraFeedback() : String
    }

    class Grupo <<Produtor-Artefatos>> {
        + grupo_id : String
        + nome_equipe : String
        + integrantes : List<String>
        + po_designado : String
        + scrum_master : String
        --
        + organizaTrabalho() : void
        + produzArtefatos() : List<Artefato>
        + preparaPitch() : Pitch
    }

    class Aluno <<Participante-Individual>> {
        + aluno_id : String
        + nome : String
        + matricula : String
        + contribuicoes_individuais : List<String>
        --
        + participaAutoestudo() : void
        + realizaAP() : void
        + contribuiArtefatos() : void
        + apresentaPitch() : void
    }

    class Parceiro <<Avaliador-Externo>> {
        + parc_id : String
        + nome_organizacao : String
        + representante_avaliador : String
        --
        + avaliaArtefatos() : Float
        + participaReview() : void
        + forneceFeedback() : String
        + validaAderencia() : Boolean
    }

    class TAPI <<Criterios-Referencia>> {
        + tapi_id : String
        + requisitos_funcionais : List<String>
        + requisitos_nao_funcionais : List<String>
        + criterios_aceite : List<String>
        + metricas_sucesso : List<String>
        --
        + validaArtefato() : Boolean
        + rastreiaImplementacao() : Map
    }
}

' Relacionamentos dos produtos da Sprint
Sprint ||--o{ Artefato : "produz\n1:1..N"
Sprint ||--|| Pitch : "culmina em\n1:1"
Sprint ||--o{ AutoEstudo : "inclui\n1:1..N"
Sprint ||--o{ AtividadePonderada : "pode ter\n1:0..N"

Grupo ||--o{ Artefato : "desenvolve\n1:N"
Grupo ||--|| Pitch : "apresenta\n1:1"
Aluno ||--o{ AutoEstudo : "realiza\n1:N"
Aluno ||--o{ AtividadePonderada : "participa\n1:N"

Parceiro ||--o{ Artefato : "avalia\n1:N"
Parceiro ||--|| Pitch : "assiste\n1:1"
TAPI ||--o{ Artefato : "valida\n1:N"

' Cardinalidades específicas por Sprint
note as CardinalidadesSprint
<b>Cardinalidades por Sprint:</b>
• 1 Sprint = 1 Pitch (obrigatório)
• 1 Sprint = 1..N Artefatos (mínimo 1)
• 1 Sprint = 1..N Autoestudos (preparatórios)
• 1 Sprint = 0..N APs (podem não ter)
• 1 Grupo = N Artefatos por Sprint
• 1 Aluno = contribui em todos os produtos
end note

note right of Artefato : **Evidência Tangível**\nCódigo, docs, protótipos\nRastreáveis ao TAPI

note left of Pitch : **Marco Obrigatório**\nApresentação de 15-30min\nAvaliação parceiro + docentes

note bottom of AutoEstudo : **Preparação Individual**\nPode ser ponderado\nBase para instruções

@enduml