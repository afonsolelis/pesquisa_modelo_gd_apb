@startuml diagrama5_metricas_indicadores
!define PRIMARY_COLOR #2E86AB
!define SECONDARY_COLOR #A23B72
!define ACCENT_COLOR #F18F01
!define SUCCESS_COLOR #C73E1D

skinparam class {
    BackgroundColor WHITE
    BorderColor PRIMARY_COLOR
    HeaderBackgroundColor PRIMARY_COLOR
    HeaderFontColor WHITE
    AttributeFontColor BLACK
    FontSize 10
}

skinparam arrow {
    Color PRIMARY_COLOR
    FontColor PRIMARY_COLOR
    FontSize 9
}

package "Métricas e Indicadores - Dimensão Analítica" {

    class EventoSistema <<Fonte-Dados>> {
        + evento_id : String
        + timestamp_ocorrencia : Date
        + timestamp_ingestao : Date
        + fonte_origem : String
        + tipo_evento : String
        + contexto : Map<String, String>
        + payload : JSON
        + chaves_juncao : Map<String, String>
        + versao_schema : String
        --
        + registraOcorrencia() : void
        + enriquece Contexto() : void
        + validaSchema() : Boolean
        + extraiChaves() : Map
        + normaliza Formato() : JSON
    }

    class Metrica <<Definicao-Indicador>> {
        + metrica_id : String
        + nome_metrica : String
        + categoria : String
        + descricao : Text
        + formula_calculo : String
        + unidade_medida : String
        + fonte_dados : List<String>
        + periodicidade_coleta : String
        + janela_temporal : String
        + limitacoes_interpretacao : Text
        + nivel_confiabilidade : Float
        + alertas_configurados : List<String>
        --
        + calculaValor() : Float
        + validaFontes() : Boolean
        + aplicaFormula() : Float
        + avalia Confiabilidade() : Float
        + geraAlertas() : List<String>
        + documenta Limitacoes() : String
    }

    class Indicador <<Valor-Calculado>> {
        + indicador_id : String
        + metrica_base : metrica_id
        + entidade_referencia : String
        + periodo_referencia : DateRange
        + valor_calculado : Float
        + valor_normalizado : Float
        + nivel_confianca : Float
        + evidencias_suporte : List<String>
        + contexto_calculo : Map
        + comparacoes_temporais : Map
        + benchmarks : Map
        --
        + recalcula Valor() : Float
        + normaliza Escala() : Float
        + comparaTemporal() : Map
        + identificaTendencia() : String
        + geraExplicacao() : Text
        + valida Coerencia() : Boolean
    }

    class TrilhaEvidencia <<Rastro-Origem>> {
        + trilha_id : String
        + indicador_origem : String
        + eventos_originais : List<evento_id>
        + transformacoes_aplicadas : List<String>
        + parametros_calculo : Map
        + versao_algoritmo : String
        + validacao_qualidade : String
        + nivel_agregacao : String
        + filtros_aplicados : List<String>
        --
        + reconstroi Calculo() : Float
        + validaIntegridade() : Boolean
        + audita Transformacoes() : List<String>
        + geraRelatorioOrigem() : Documento
        + verifica Reproducibilidade() : Boolean
    }

    class Dashboard <<Interface-Visualizacao>> {
        + dash_id : String
        + nome_dashboard : String
        + stakeholder_alvo : String
        + indicadores_exibidos : List<indicador_id>
        + layout_configuracao : JSON
        + filtros_disponiveis : List<String>
        + alertas_ativos : List<String>
        + frequencia_atualizacao : String
        + nivel_acesso : String
        --
        + renderiza Visualizacao() : View
        + aplicaFiltros() : void
        + atualiza Dados() : void
        + gera Alertas() : List<String>
        + exporta Relatorio() : File
        + personaliza Layout() : void
    }

    class ComplexEventProcessing <<CEP-Engine>> {
        + cep_id : String
        + regras_correlacao : List<String>
        + janelas_temporais : Map
        + padroes_detectados : List<String>
        + agregacoes_configuradas : Map
        + alertas_complexos : List<String>
        + estado_processamento : Map
        --
        + processa EventoFluxo() : void
        + detectaPadroes() : List<String>
        + correlaEventos() : Map
        + agregaTemporal() : Map
        + dispara Alertas() : void
        + mantemEstado() : void
    }

    enum CategoriaMetrica {
        PRODUTIVIDADE_TECNICA
        COLABORACAO_EQUIPE
        ADERENCIA_PROCESSO
        QUALIDADE_ARTEFATO
        ENGAJAMENTO_PEDAGOGICO
        EVOLUCAO_COMPETENCIA
    }

    enum TipoEvento {
        EVENTO_ACADEMICO
        EVENTO_OPERACIONAL
        EVENTO_TECNICO
        EVENTO_DOCUMENTAL
    }

    enum NivelAgregacao {
        INDIVIDUAL_ESTUDANTE
        EQUIPE
        SPRINT
        MODULO
        TURMA
    }
}

' Relacionamentos de processamento
EventoSistema --> ComplexEventProcessing : "alimenta\nstream"
ComplexEventProcessing ||--o{ Metrica : "alimenta\ncálculo"
Metrica ||--o{ Indicador : "produz\nvalores"
Indicador ||--|| TrilhaEvidencia : "documenta\norigem"
Dashboard ||--o{ Indicador : "exibe\n1..* indicadores"

' Relacionamentos com enums
Metrica --> CategoriaMetrica
EventoSistema --> TipoEvento
Indicador --> NivelAgregacao

' Notas explicativas
note top of EventoSistema : **Fonte Primária**\nMultiplas origens integradas\nCarimbos de tempo distintos\nChaves de junção padronizadas

note right of Metrica : **Definição de KPI**\nFórmula explícita\nFonte + periodicidade\nLimitações documentadas

note bottom of Indicador : **Valor Contextualizado**\nEvidências rastreáveis\nComparação temporal\nNível de confiança

note left of ComplexEventProcessing : **Engine CEP**\nCorrelação de eventos\nDetecção de padrões\nAgregação temporal

' Taxonomia de métricas
note as N5
    <b>Taxonomia de Métricas (6 Categorias):</b>

    <b>1. Produtividade Técnica:</b>
    • Commits/dia, PRs/sprint, Lines of Code
    • Velocity, Throughput, Cycle Time

    <b>2. Colaboração:</b>
    • Code reviews, Co-authoring
    • Participação em discussões técnicas

    <b>3. Aderência a Processo:</b>
    • Rituais realizados, Backlog atualizado
    • Conformidade ágil

    <b>4. Qualidade:</b>
    • Cobertura testes, Complexidade
    • Debt técnico, Bug rate

    <b>5. Engajamento:</b>
    • Frequência, Participação APs
    • Interação com recursos

    <b>6. Evolução:</b>
    • Progressão competências
    • Melhoria contínua
end note

@enduml