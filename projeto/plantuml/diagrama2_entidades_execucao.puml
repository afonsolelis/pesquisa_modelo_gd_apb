@startuml diagrama2_entidades_execucao
!define PRIMARY_COLOR #2E86AB
!define SECONDARY_COLOR #A23B72
!define ACCENT_COLOR #F18F01
!define SUCCESS_COLOR #C73E1D

skinparam class {
    BackgroundColor WHITE
    BorderColor PRIMARY_COLOR
    HeaderBackgroundColor PRIMARY_COLOR
    HeaderFontColor WHITE
    AttributeFontColor BLACK
    FontSize 10
}

skinparam arrow {
    Color PRIMARY_COLOR
    FontColor PRIMARY_COLOR
    FontSize 9
}

package "Entidades de Execução - Estrutura Operacional" {

    class Modulo <<from Núcleo>> {
        + mod_id : String
        + titulo : String
        + duracao_semanas : Integer = 10
    }

    class Equipe <<Unidade-Trabalho>> {
        + team_id : String
        + nome_equipe : String
        + integrantes : List<stud_id>
        + product_owner : stud_id
        + scrum_master : stud_id
        + data_formacao : Date
        + status_ativo : Boolean
        + backlog_proprio : List<BacklogItem>
        --
        + defineRoles() : void
        + organizaRituaisAgeis() : void
        + entregaIncrementos() : List<Artefato>
        + realizaPlanning() : Sprint
        + executaDailies() : void
        + conduzReview() : Feedback
        + fazRetrospectiva() : List<String>
    }

    class Estudante <<Participante-Individual>> {
        + stud_id : String
        + nome : String
        + matricula : String
        + turma_origem : String
        + email : String
        + competencias_previas : List<String>
        + historico_modulos : List<String>
        --
        + executaTarefas() : void
        + participaRituais() : void
        + versionaCodigo() : List<Commit>
        + registraDecisoes() : void
        + colaboraEquipe() : void
        + recebeAvaliacao() : Nota
    }

    class Sprint <<Ciclo-Desenvolvimento>> {
        + sprint_n : Integer
        + metas_estabelecidas : List<String>
        + backlog_selecionado : List<BacklogItem>
        + data_inicio : Date
        + data_fim : Date
        + duracao_semanas : Integer = 2
        + marcos_temporais : List<Marco>
        + review_agendada : Date
        + status : String
        --
        + iniciaPlanning() : void
        + executaIteracao() : void
        + realizaReview() : ReviewResult
        + consolidaEvidencias() : List<Evidencia>
        + calculaVelocidade() : Integer
        + atualizaBacklog() : void
    }

    class BacklogItem <<Item-Planejamento>> {
        + backlog_id : String
        + descricao : Text
        + prioridade : Integer
        + estimativa_esforco : Integer
        + estado_atual : String
        + req_tapi_id : String
        + responsavel : stud_id
        + criterios_aceite : List<String>
        + dependencias : List<backlog_id>
        --
        + atualizaStatus() : void
        + vinculaRequisito() : void
        + estimaComplexidade() : Integer
        + validaAceite() : Boolean
    }

    class Papel <<Role-Agil>> {
        + papel_id : String
        + nome_papel : String
        + responsabilidades : List<String>
        + periodo_exercicio : DateRange
        + estudante_atual : stud_id
        + historico_ocupantes : List<stud_id>
        --
        + defineResponsabilidades() : void
        + transferePapel() : void
        + avaliaDesempenho() : String
    }

    enum StatusSprint {
        PLANEJADA
        EM_ANDAMENTO
        EM_REVIEW
        FINALIZADA
        AJUSTADA
    }

    enum EstadoBacklog {
        NOVO
        REFINADO
        SELECIONADO
        EM_DESENVOLVIMENTO
        EM_TESTE
        CONCLUIDO
        CANCELADO
    }
}

' Relacionamentos estruturais
Modulo ||--o{ Equipe : "forma\n2..8 equipes"
Modulo ||--o{ Sprint : "organiza\n5 sprints"
Equipe }o--o{ Estudante : "composta por\n3..7 estudantes"
Equipe ||--o{ Papel : "define\n2+ papéis"
Estudante ||--o{ Papel : "exerce\n1..N papéis"
Sprint ||--o{ BacklogItem : "executa\n1..* itens"
Equipe ||--o{ BacklogItem : "mantém\n backlog próprio"

' Relacionamentos temporais
Sprint --> StatusSprint
BacklogItem --> EstadoBacklog

' Notas explicativas
note top of Equipe : **Unidade de Execução**\nPO + Scrum Master\nRituais ágeis obrigatórios\nBacklog próprio por equipe

note right of Sprint : **Janela Temporal**\n2 semanas fixas\nPlanning → Execução → Review\nEvidências consolidadas

note bottom of Estudante : **Ator Individual**\nContribuições rastreáveis\nAvaliação multidimensional\nProgressão de competências

note left of BacklogItem : **Unidade de Trabalho**\nRastreável ao TAPI\nCritérios de aceite claros\nPriorização dinâmica

' Cardinalidades importantes
note as N2
    <b>Restrições de Cardinalidade:</b>
    • 1 Módulo = exatamente 5 Sprints
    • 1 Equipe = 3 a 7 estudantes
    • 1 Sprint = 2 semanas (fixo)
    • Papéis PO/SM obrigatórios por equipe
    • Backlog vinculado a requisitos TAPI
end note

@enduml