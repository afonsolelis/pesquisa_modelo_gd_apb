@startuml diagrama_macro_simplificado
!define PRIMARY_COLOR #2E86AB
!define SECONDARY_COLOR #A23B72
!define ACCENT_COLOR #F18F01
!define SUCCESS_COLOR #C73E1D

skinparam class {
    BackgroundColor WHITE
    BorderColor PRIMARY_COLOR
    HeaderBackgroundColor PRIMARY_COLOR
    HeaderFontColor WHITE
    FontSize 12
}

skinparam arrow {
    Color PRIMARY_COLOR
    FontColor PRIMARY_COLOR
    FontSize 10
}

package "Modelagem Macro - Visão Geral" {

    class DCN <<Norma-Reguladora>>
    class "PPC (MEC)" as PPC <<Documento-Regulador>>
    class Curso <<Entidade-Institucional>>
    class Metaprojeto <<Template-Pedagogico>>
    class Modulo <<Unidade-Execucao>>
    class Sprint <<Ciclo-2Semanas>>
    class Turma <<Grupo-Estudantes>>
    class Aluno <<Participante>>
    class Grupo <<Equipe-Desenvolvimento>>
    class Orientador <<Docente-Facilitador>>
    class Parceiro <<Stakeholder-Externo>>
    class TAPI <<Documento-Projeto>>
    class Artefato <<Produto-Tangivel>>
    class Pitch <<Apresentacao-Obrigatoria>>
    class AutoEstudo <<Atividade-Preparatoria>>
    class AtividadePonderada <<Avaliacao-Formal>>
}

' Relacionamentos hierárquicos principais
DCN ||--o{ Curso : "nomeia\n1:N"
DCN ||--o{ Metaprojeto : "regula\n1:N"
PPC ||--o{ Metaprojeto : "define\n1:N"
Curso ||--o{ Metaprojeto : "tem\n1:N"
Metaprojeto ||--o{ Modulo : "instancia\n1:N"

' Estrutura operacional
Modulo ||--o{ Sprint : "contém\n1:5"
Modulo ||--o{ Turma : "executa\n1:N"
Turma ||--o{ Aluno : "composta por\n1:N"
Turma ||--o{ Grupo : "organizada em\n1:N"
Aluno ||--|| Grupo : "pertence a\n1:1"
Orientador ||--o{ Turma : "orienta\n1:N"

' Contexto do problema
Sprint }o--|| Parceiro : "envolve\n1:1"
Sprint }o--|| TAPI : "segue\n1:1"
Parceiro ||--|| TAPI : "define\n1:1"

' Produtos da Sprint
Sprint ||--o{ Artefato : "produz\n1:1..N"
Sprint ||--|| Pitch : "culmina em\n1:1"
Sprint ||--o{ AutoEstudo : "inclui\n1:1..N"
Sprint ||--o{ AtividadePonderada : "pode ter\n1:0..N"

' Responsabilidades
Grupo ||--o{ Artefato : "desenvolve\n1:N"
Grupo ||--|| Pitch : "apresenta\n1:1"
Aluno ||--o{ AutoEstudo : "realiza\n1:N"
Aluno ||--o{ AtividadePonderada : "participa\n1:N"


@enduml