@startuml diagrama6_modelo_integrado
!define PRIMARY_COLOR #2E86AB
!define SECONDARY_COLOR #A23B72
!define ACCENT_COLOR #F18F01
!define SUCCESS_COLOR #C73E1D

skinparam class {
    BackgroundColor WHITE
    BorderColor PRIMARY_COLOR
    HeaderBackgroundColor PRIMARY_COLOR
    HeaderFontColor WHITE
    AttributeFontColor BLACK
    FontSize 9
}

skinparam arrow {
    Color PRIMARY_COLOR
    FontColor PRIMARY_COLOR
    FontSize 8
}

skinparam package {
    BackgroundColor #F8F9FA
    BorderColor PRIMARY_COLOR
    FontColor PRIMARY_COLOR
}

package "NÚCLEO CENTRAL" {
    class Curso {
        + curso_id : String
        + competencias_alvo : List<String>
    }

    class Modulo {
        + mod_id : String
        + objetivos_aprendizagem : List<String>
        + duracao_semanas : Integer = 10
    }

    class TAPI {
        + tapi_id : String
        + requisitos : Map<req_tapi_id, String>
    }

    class Parceiro {
        + parc_id : String
        + contexto_organizacional : Text
    }
}

package "EXECUÇÃO OPERACIONAL" {
    class Equipe {
        + team_id : String
        + product_owner : stud_id
        + scrum_master : stud_id
    }

    class Sprint {
        + sprint_n : Integer
        + duracao_semanas : Integer = 2
        + backlog_selecionado : List<BacklogItem>
    }

    class Estudante {
        + stud_id : String
        + competencias_previas : List<String>
    }

    class BacklogItem {
        + backlog_id : String
        + req_tapi_id : String
        + prioridade : Integer
    }
}

package "DIMENSÃO PEDAGÓGICA" {
    class Instrucao {
        + inst_id : String
        + eixo_conhecimento : String
        + registros_presenca : Map<stud_id, Boolean>
    }

    class AtividadePonderada {
        + ap_id : String
        + peso_avaliativo : Float
        + criterios_avaliacao : List<String>
    }

    class Avaliacao {
        + aval_id : String
        + eixo_avaliado : String
        + nota_final : Float
        + justificativas : Text
    }

    class Prova {
        + exam_id : String
        + peso_modulo : Float = 0.20
    }
}

package "ARTEFATOS TÉCNICOS" {
    class Artefato {
        + artifact_id : String
        + tipo_artefato : String
        + autores : List<stud_id>
        + backlog_vinculado : List<backlog_id>
    }

    class CommitPR {
        + hash_commit : String
        + autor : stud_id
        + backlog_referenciado : List<backlog_id>
    }

    class PitchReview {
        + review_id : String
        + artefatos_demonstrados : List<artifact_id>
        + feedback_parceiro : Text
    }
}

package "MÉTRICAS E INDICADORES" {
    class EventoSistema {
        + evento_id : String
        + tipo_evento : String
        + chaves_juncao : Map<String, String>
    }

    class Metrica {
        + metrica_id : String
        + formula_calculo : String
        + categoria : String
    }

    class Indicador {
        + valor_calculado : Float
        + evidencias_suporte : List<String>
        + trilha_origem : String
    }

    class ComplexEventProcessing {
        + regras_correlacao : List<String>
        + padroes_detectados : List<String>
    }
}

' ========================================
' RELACIONAMENTOS PRINCIPAIS
' ========================================

' Núcleo Central
Curso ||--o{ Modulo
Modulo ||--|| TAPI
Modulo }o--|| Parceiro
TAPI }o--|| Parceiro

' Execução Operacional
Modulo ||--o{ Equipe
Modulo ||--o{ Sprint : "5 sprints"
Equipe }o--o{ Estudante
Sprint ||--o{ BacklogItem
BacklogItem }o--|| TAPI : "req_tapi_id"

' Dimensão Pedagógica
Modulo ||--o{ Instrucao
Modulo ||--|| Prova
Instrucao ||--o{ AtividadePonderada
Modulo ||--o{ Avaliacao : "4 eixos × N estudantes"
Estudante ||--o{ Avaliacao

' Artefatos Técnicos
Sprint ||--o{ Artefato
BacklogItem ||--o{ Artefato
Artefato ||--o{ CommitPR
Sprint ||--|| PitchReview
PitchReview ||--o{ Artefato

' Métricas e Indicadores
EventoSistema --> ComplexEventProcessing
ComplexEventProcessing ||--o{ Metrica
Metrica ||--o{ Indicador

' Integração cross-package
Estudante --> EventoSistema : "gera eventos"
CommitPR --> EventoSistema : "gera eventos"
Instrucao --> EventoSistema : "gera eventos"
PitchReview --> EventoSistema : "gera eventos"

' ========================================
' IDENTIFICADORES CANÔNICOS E RASTREABILIDADE
' ========================================

note top of TAPI : <b>Identificadores Canônicos:</b>\n• mod_id, team_id, stud_id\n• sprint_n, req_tapi_id\n• backlog_id, artifact_id

note bottom of Indicador : <b>Cadeia de Rastreabilidade:</b>\nTAPI → Backlog → PR/Commit → Artefato → Review → Avaliação

note left of ComplexEventProcessing : <b>Complex Event Processing:</b>\nCorrelação temporal de eventos\nDetecção de padrões\nAgregação por visão arquitetural

note right of Avaliacao : <b>Sistema Avaliativo Integrado:</b>\n• Artefatos/Projeto (40%)\n• Atividades Ponderadas (35%)\n• Prova Escrita (20%)\n• Avaliação de Pares (5%)

' ========================================
' VISÕES ARQUITETURAIS (ISO/IEC/IEEE 42010:2022)
' ========================================

note as VISOES
<b>Três Visões Arquiteturais Integradas:</b>

<b>🏗️ VISÃO ESTRUTURAL:</b>
• Organização estática: Equipes, Recursos, Arquitetura
• Entidades: Curso, Módulo, Equipe, Estudante, Artefatos
• Relacionamentos: Composição, Associação, Dependência

<b>🤝 VISÃO COMPORTAMENTAL:</b>
• Interações dinâmicas: Colaboração, Comunicação
• Entidades: Instruções, Reviews, Atividades Ponderadas
• Padrões: Rituais ágeis, Dinâmicas de equipe

<b>⚙️ VISÃO DE PROCESSO:</b>
• Fluxos temporais: Sprints, Marcos, Entregas
• Entidades: Sprint, BacklogItem, Commits, Métricas
• Evolução: Metodologias, Qualidade, Melhoria contínua
end note

@enduml