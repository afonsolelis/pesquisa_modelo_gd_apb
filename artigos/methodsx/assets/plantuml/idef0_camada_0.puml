@startuml idef0_camada_0

skinparam monochrome true
skinparam shadowing false
skinparam rectangle {
    BackgroundColor WHITE
    BorderColor BLACK
    FontColor BLACK
    FontSize 11
    BorderThickness 2
}

skinparam arrow {
    Color BLACK
    FontColor BLACK
    FontSize 10
    Thickness 2
}

skinparam linetype ortho

' Controles (parte superior)
rectangle "MEC/DIRETRIZES Curriculares\nPPC/ES" as controles

' Entradas (lado esquerdo)
rectangle "Alunos\nAtividades\nComportamento" as entradas

' Função principal (centro)
rectangle "INTELI\nPBL Engenharia de\nSoftware\n\nA0" as funcao_principal

' Saídas (lado direito)
rectangle "Alunos com Conhecimentos\nArtefatos\nEvidências" as saidas

' Mecanismos (parte inferior)
rectangle "Adalove\nGPS, Catracas e Imagens\nRepositório Docs\nRepositório GIT (Hardware e Software)" as mecanismos

' Posicionamento usando coordenadas
controles -[hidden]down- funcao_principal
entradas -[hidden]right- funcao_principal
funcao_principal -[hidden]right- saidas
funcao_principal -[hidden]down- mecanismos

' Relacionamentos IDEF0 com linhas retas
controles -down-> funcao_principal
entradas -right-> funcao_principal
funcao_principal -right-> saidas
mecanismos -up-> funcao_principal

@enduml