@startuml diagrama1_nucleo_central
!define PRIMARY_COLOR #2E86AB
!define SECONDARY_COLOR #A23B72
!define ACCENT_COLOR #F18F01
!define SUCCESS_COLOR #C73E1D

skinparam class {
    BackgroundColor WHITE
    BorderColor PRIMARY_COLOR
    HeaderBackgroundColor PRIMARY_COLOR
    HeaderFontColor WHITE
    AttributeFontColor BLACK
    FontSize 10
}

skinparam arrow {
    Color PRIMARY_COLOR
    FontColor PRIMARY_COLOR
    FontSize 9
}

package "Núcleo Central do Modelo PBL" {

    class Curso <<Entidade-Raiz>> {
        + curso_id : String
        + nome : String
        + competencias_alvo : List<String>
        + perfil_egresso : String
        + carga_horaria : Integer
        + padroes_avaliacao : String
        + calendario_institucional : Date
        + politicas_internas : String
        --
        + defineRecursos() : void
        + estabeleceDiretrizes() : void
        + forneceProfessores() : List<Docente>
    }

    class Modulo <<Unidade-Pedagogica>> {
        + mod_id : String
        + titulo : String
        + data_inicio : Date
        + data_fim : Date
        + duracao_semanas : Integer = 10
        + objetivos_aprendizagem : List<String>
        + competencias_especificas : List<String>
        + calendario_marcos : List<Marco>
        --
        + iniciaConfiguracao() : void
        + executaSprints() : void
        + consolidaResultados() : void
        + geraRelatorio() : Relatorio
    }

    class TAPI <<Documento-Formal>> {
        + tapi_id : String
        + versao : String
        + descricao_problema : Text
        + escopo_projeto : Text
        + objetivos : List<String>
        + requisitos : Map<req_tapi_id, String>
        + criterios_aceite : List<String>
        + restricoes : List<String>
        + premissas : List<String>
        + recursos_disponiveis : List<String>
        + limites_eticos : String
        + politica_privacidade : String
        --
        + validaEscopo() : Boolean
        + atualizaRequisitos() : void
        + geraRastreabilidade() : Map
    }

    class Parceiro <<Entidade-Externa>> {
        + parc_id : String
        + nome_organizacao : String
        + setor_atuacao : String
        + contato_responsavel : String
        + contexto_organizacional : Text
        + historico_parcerias : List<String>
        --
        + apresentaProblema() : void
        + participaWorkshop() : void
        + avaliaEntregas() : Feedback
        + validaSolucoes() : Boolean
        + forneceFeedback() : String
    }

    class Marco <<Evento-Temporal>> {
        + marco_id : String
        + nome : String
        + data_prevista : Date
        + data_realizada : Date
        + tipo : String
        + participantes : List<String>
        + obrigatorio : Boolean
    }

    class Feedback <<Resultado-Avaliativo>> {
        + feedback_id : String
        + autor : String
        + data : Date
        + tipo : String
        + conteudo : Text
        + nota_qualitativa : String
        + recomendacoes : List<String>
    }
}

' Relacionamentos principais
Curso ||--o{ Modulo : "contém\n1..*"
Modulo ||--|| TAPI : "referencia\n1..1"
Modulo }o--|| Parceiro : "associa-se\n1..1"
TAPI }o--|| Parceiro : "definido por\n1..1"
Modulo ||--o{ Marco : "possui marcos\n5..*"
Parceiro ||--o{ Feedback : "produz\n0..*"

' Notas explicativas
note top of Curso : **Entidade-Raiz**\nContexto institucional\nque define recursos\ne diretrizes gerais

note right of Modulo : **Unidade Central**\n10 semanas\n5 sprints\nObjectivos específicos

note bottom of TAPI : **Contrato de Referência**\nProblema + Objetivos + Escopo\nCritérios de aceite\nRastreabilidade completa

note left of Parceiro : **Mundo Real**\nProblemas autênticos\nValidação contextual\nFeedback especializado

' Regras de negócio importantes
note as N1
    <b>Regras de Dependência:</b>
    • Módulo SEM Parceiro = Inválido
    • TAPI deve estar aprovado antes do início
    • Marcos obrigatórios: Apresentação,
      Workshop, 5 Reviews, Prova Final
end note

@enduml