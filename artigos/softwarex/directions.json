  "conventional_commits_guide": {
    "types": {
      "feat": "A new feature for the user",
      "fix": "A bug fix for the user",
      "docs": "Documentation only changes",
      "style": "Changes that do not affect the meaning of the code",
      "refactor": "A code change that neither fixes a bug nor adds a feature",
      "test": "Adding missing tests or correcting existing tests",
      "chore": "Changes to the build process or auxiliary tools"
    },
    "scopes": {
      "article": "Changes to the main article content",
      "diagrams": "Changes to UML diagrams or PlantUML files",
      "structure": "Changes to project structure or organization",
      "compilation": "Changes to LaTeX compilation process",
      "docs": "Changes to documentation files",
      "deps": "Changes to dependencies or external tools"
    },
    "breaking_changes": {
      "indicator": "!",
      "example": "feat!: redesign article structure with new sections"
    }
  },
  "best_practices": {
    "before_any_changes": [
      "1. Check git status",
      "2. Create backup commit",
      "3. Make changes",
      "4. Test compilation if LaTeX",
      "5. Commit with conventional format"
    ],
    "commit_frequency": "After each logical unit of work",
    "commit_message_length": "Keep description under 50 characters",
    "testing_commands": {
