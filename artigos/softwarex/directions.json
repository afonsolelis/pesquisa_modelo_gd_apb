  "git_workflow": {
    "always_commit_changes": true,
    "commit_format": "conventional_commits",
    "commit_message_structure": {
      "type": "Required - one of: feat, fix, docs, style, refactor, test, chore",
      "scope": "Optional - component or area affected",
      "description": "Required - brief description of changes",
      "body": "Optional - detailed explanation",
      "footer": "Optional - breaking changes, issues closed"
    },
    "examples": {
      "feat": "feat(article): add PBLRepositoriesMetrics system documentation",
      "fix": "fix(diagrams): correct UML class diagram references",
      "docs": "docs(readme): update installation instructions",
      "style": "style(tex): improve LaTeX formatting and layout",
      "refactor": "refactor(structure): reorganize project directories",
      "test": "test(compilation): verify LaTeX compilation process",
      "chore": "chore(deps): update PlantUML version"
    }
  },
  "workflow_commands": {
    "before_modifications": [
      "git pull",
      "git status",
      "git add .",
      "git commit -m 'chore: save current state before modifications'"
    ],
    "after_modifications": [
      "git add .",
      "git commit -m '[TYPE]([SCOPE]): [DESCRIPTION]'",
      "git push",
      "git log --oneline -5"
    ],
    "rollback_commands": {
      "undo_last_commit": "git reset --soft HEAD~1",
      "undo_last_commit_keep_changes": "git reset HEAD~1",
      "undo_last_commit_discard_changes": "git reset --hard HEAD~1",
      "view_commit_history": "git log --oneline -10",
      "revert_specific_commit": "git revert [COMMIT_HASH]"
    }
  },
  "project_structure": {
    "main_files": {
      "latex_source": "pblrepositoriesmetrics.tex",
